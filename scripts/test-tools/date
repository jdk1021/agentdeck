#!/usr/bin/env python3
"""GNU date compatibility for two upstream test fixture expressions on macOS."""
import datetime
import os
import subprocess
import sys
if len(sys.argv) >= 4 and sys.argv[1] == '-d':
    value, fmt = sys.argv[2:4]
    if value == 'tomorrow 00:00':
        date = datetime.datetime.now().replace(hour=0, minute=0, second=0, microsecond=0) + datetime.timedelta(days=1)
    else:
        date = datetime.datetime.fromisoformat(value.replace('Z', '+00:00')).astimezone()
    print(int(date.timestamp()) if fmt == '+%s' else date.strftime(fmt.replace('+', '', 1).replace('%F', '%Y-%m-%d')))
else:
    os.execv('/bin/date', ['date'] + sys.argv[1:])
