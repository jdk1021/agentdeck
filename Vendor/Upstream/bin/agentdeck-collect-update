#!/bin/bash

# agentdeck:summary=Regenerate the AI agent usage data files
# agentdeck:args=[--force] [--limits-only] [--except <agent>] [agent...]
# agentdeck:examples=agentdeck agent usage-update | agentdeck agent usage-update claude | agentdeck agent usage-update --except codex

# Each agentdeck-collect-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/agentdeck/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agentdeck/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "agentdeck-collect-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

# Accounts can be signed in to someone else since they were added; the
# records name them from the registry, so bring it up to date first.
accounts_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agentdeck/agents/accounts"
if [[ -d $accounts_dir ]]; then
  "$AGENTDECK_RUNTIME/bin/agentdeck-account-state" refresh
fi

# Collectors forced together read the Codex rollouts they share once between
# them, whenever each gets to them, by knowing when this refresh began.
# EPOCHREALTIME uses the locale's decimal separator, a comma in many.
export AGENTDECK_REFRESH_AT=${EPOCHREALTIME/,/.}

pids=()
for collector in "$AGENTDECK_RUNTIME"/bin/agentdeck-collect-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/agentdeck-collect-}"
  [[ $agent == "update" ]] && continue
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done

# Fresh limits are when switching accounts near a limit gets decided. A switch
# changes which account the record's own limits describe, so that record is
# collected once more; the limits probes it repeats are still cached.
for agent in claude codex grok; do
  if wanted "$agent" && [[ -f $accounts_dir/$agent.json ]]; then
    switched=$("$AGENTDECK_RUNTIME/bin/agentdeck-account-state" autoswitch "$agent")
    if [[ -n $switched ]]; then
      flags=(--limits-only)
      collect "$AGENTDECK_RUNTIME/bin/agentdeck-collect-$agent" "$agent" || status=1
    fi
  fi
done

exit $status
